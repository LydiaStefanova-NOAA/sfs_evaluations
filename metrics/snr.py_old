"""
Signal-to-Noise Ratio (SNR) metric calculation engine.
"""
import logging
import numpy as np
import xarray as xr

logger = logging.getLogger(__name__)


def compute_signal_to_noise_ratio(
    ds_anom: xr.Dataset | xr.DataArray,
    year_dim: str | None = None,
    member_dim: str = "member",
    use_std_ratio: bool = True,
) -> xr.Dataset | xr.DataArray:
    """
    Compute Signal-to-Noise Ratio (SNR) for ensemble reforecast anomalies.

    Parameters
    ----------
    ds_anom : xr.Dataset or xr.DataArray
        Forecast anomaly data with year and ensemble member dimensions.
    year_dim : str, optional
        Dimension representing interannual time/initialization years.
        If None, automatically picks 'year' or 'init'.
    member_dim : str
        Dimension representing ensemble members (default: 'member').
    use_std_ratio : bool
        If True, returns ratio of Standard Deviations (sigma_signal / sigma_noise).
        If False, returns ratio of Variances (var_signal / var_noise).

    Returns
    -------
    xr.Dataset or xr.DataArray
        Calculated SNR matching the input container type.
    """
    if member_dim not in ds_anom.dims:
        raise ValueError(f"Member dimension '{member_dim}' required to compute SNR.")

    # Auto-detect year dimension if not explicitly provided
    if year_dim is None:
        if "year" in ds_anom.dims:
            year_dim = "year"
        elif "init" in ds_anom.dims:
            year_dim = "init"
        else:
            raise ValueError("Could not auto-detect year dimension. Expected 'year' or 'init'.")

    # 1. Ensemble Mean Forecast (Signal Component)
    ens_mean = ds_anom.mean(dim=member_dim, skipna=True)

    # 2. Signal Variance: Interannual variance of ensemble mean
    var_signal = ens_mean.var(dim=year_dim, ddof=1, skipna=True)

    # 3. Noise Variance: Member variance around ensemble mean, averaged over years
    member_diff = ds_anom - ens_mean
    var_noise = (member_diff ** 2).mean(dim=member_dim, skipna=True).mean(dim=year_dim, skipna=True)

    # 4. Calculate SNR
    if use_std_ratio:
        signal = np.sqrt(var_signal)
        noise = np.sqrt(var_noise)
        snr = signal / noise
    else:
        signal = var_signal
        noise = var_noise
        snr = signal / noise

    # Handle Dataset input
    if isinstance(ds_anom, xr.Dataset):
        ds_snr = xr.Dataset()
        for var in ds_anom.data_vars:
            ds_snr[var] = snr[var]
            ds_snr[f"{var}_signal"] = signal[var]
            ds_snr[f"{var}_noise"] = noise[var]
        return ds_snr

    # Handle DataArray input
    snr.name = "SNR"
    return snr


# Alias function name for backward compatibility and clean imports
compute_snr = compute_signal_to_noise_ratio
